# PostgreSQL connection
DATABASE_URL=postgres://ccms_user:your_password@localhost:5432/ccms_db

# Alternatively, use individual PG* variables:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=ccms_user
# PGPASSWORD=your_password
# PGDATABASE=ccms_db

# Server
PORT=8000

# Admin key for dashboard commands (relay on/off, etc.)
ADMIN_KEY=admin123

# Dashboard login. The default admin is created on first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Secret used to sign login tokens (auto-generated into .auth_secret if empty)
AUTH_SECRET=
# Role given to people who use "Sign Up": user (view only) or admin
SIGNUP_ROLE=user

# Time zone used for sunrise / sunset times shown and scheduled
LOCAL_TZ=Asia/Kolkata
